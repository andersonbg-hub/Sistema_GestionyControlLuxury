{
  "folders": [
    { "name": "Luxury · Flutter", "path": "luxury-flutter-fuente" },
    { "name": "Luxury · Supabase", "path": "supabase" }
  ],
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Luxury en Chrome con Supabase",
        "type": "dart",
        "request": "launch",
        "cwd": "${workspaceFolder:Luxury · Flutter}",
        "program": "${workspaceFolder:Luxury · Flutter}/lib/main.dart",
        "deviceId": "chrome",
        "toolArgs": ["--dart-define-from-file=config/supabase.public.json"]
      }
    ]
  }
}
